# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=commercial

# ── WAHA (WhatsApp HTTP API) ──────────────────────────────────────────────────
# URL donde corre WAHA. En Docker Compose local: http://localhost:3001
# En producción con docker-compose: http://waha:3000
WAHA_API_URL=http://localhost:3001
WAHA_API_KEY=

# URL pública del backend — WAHA envía webhooks aquí
# En desarrollo: usar ngrok (ngrok http 8000) y poner la URL generada
# En producción: https://tu-dominio.com
APP_PUBLIC_URL=https://tu-dominio.com

# ── LLM — usar OpenAI o DeepSeek (al menos uno requerido) ────────────────────
# DeepSeek es más económico; OpenAI da mejor calidad en casos ambiguos
# Prioridad: si OPENAI_API_KEY está, se usa gpt-4o-mini. Si no, deepseek-chat.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ── Email — reset de PIN (opcional) ──────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Evolution API (legacy, opcional) ─────────────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ── Integraciones opcionales ──────────────────────────────────────────────────
SMSFAST_API_KEY=
N8N_WEBHOOK_URL=
