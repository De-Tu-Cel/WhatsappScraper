# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=commercial

# ── URL pública del backend (webhooks, links en mensajes) ────────────────────
# En desarrollo: usar ngrok (ngrok http 8000) y poner la URL generada
# En producción: https://api.detucel.com
APP_PUBLIC_URL=https://app.detucel.com

# ── wwebjs (WhatsApp personal number — provider activo) ──────────────────────
# URL donde corre apps/wwebjs. En docker-compose: http://wwebjs:3001
WWEBJS_URL=http://localhost:3002
WWEBJS_API_SECRET=
# Cuentas conectadas se mandan mensajes entre sí (vía LLM) para generar
# actividad de "número sano". false = apagado (comportamiento actual).
WARMUP_ENABLED=false

# Proxy residencial (opcional) — enmascara la IP de salida hacia WhatsApp Web.
# PROXY_SERVER admite esquema (ej. socks5://host:puerto) o sin él para HTTP
# (ej. gate.proveedor.com:7000), igual que el flag --proxy-server de Chromium.
# Vacío = sin proxy, sale directo con la IP del servidor (comportamiento actual).
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
# Opcional: lista separada por comas de session IDs que deben usar el proxy.
# Vacío = el proxy aplica a TODAS las sesiones. Úsalo para probar el proxy
# contra una sola sesión de prueba sin tocar las cuentas reales.
PROXY_ONLY_SESSIONS=

# ── WAHA (WhatsApp HTTP API — legacy, en desuso) ──────────────────────────────
WAHA_API_URL=http://localhost:3001
WAHA_API_KEY=

# ── Evolution API (legacy, en desuso) ─────────────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ── WasenderAPI (legacy, en desuso) ───────────────────────────────────────────
WASENDER_PAT=
WASENDER_BASE_URL=https://www.wasenderapi.com

# ── LLM — OpenAI, DeepSeek o Anthropic (al menos uno requerido) ──────────────
# Selecciona el proveedor explícitamente para evitar depender de otras claves presentes.
OPENAI_API_KEY=
# Selección explícita opcional: auto, openai, deepseek o anthropic.
# Para Claude: LLM_PROVIDER=anthropic y CLASSIFIER_MODEL=claude-haiku-5-5.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Si CLASSIFIER_MODEL ya existe en producción, cambiarlo también al pasar a Claude:
# CLASSIFIER_MODEL=claude-haiku-5-5
# Chat IA atiende de 08:00 a 19:00 de Ciudad de México (regla del código).
# Fuera de ese horario conserva los pendientes y los retoma con los delays habituales.
# Consultas de gasto: clave Admin independiente de la clave de inferencia.
OPENAI_ADMIN_API_KEY=
# Proyecto cuyo gasto vigilar (no sumar proyectos ajenos de la organización).
OPENAI_PROJECT_ID=
# Referencia mensual para avisos al 80% y 95%; NO representa crédito prepago.
# 0 desactiva estos avisos. No impone un límite ni pausa la IA.
OPENAI_MONTHLY_BUDGET_USD=10
DATAFORSEO_LOW_BALANCE_USD=5
DATAFORSEO_CRITICAL_BALANCE_USD=1
# La verificación automática usa un cliente no oficial; las pausas no
# garantizan ausencia de restricciones. Desactivada por defecto.
PHONE_VERIFICATION_AUTO_ENABLED=false
# Lunes a viernes; horas locales de Ciudad de México. Pendientes se conservan.
PHONE_VERIFICATION_START_HOUR=9
PHONE_VERIFICATION_END_HOUR=18
DEEPSEEK_API_KEY=

# ── Búsqueda de prospectos ────────────────────────────────────────────────────
BRIGHTDATA_SERP_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPAPI_KEY=

# ── Email — reset de PIN (opcional) ──────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Warmup ────────────────────────────────────────────────────────────────────
WARMUP_ENABLED=

# ── Integraciones opcionales ──────────────────────────────────────────────────
SMSFAST_API_KEY=
SMSFAST_SERVICE=wa
N8N_WEBHOOK_URL=

# ── Frontend (apps/web) ────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
# Andy Bot Builder — necesario solo si se usa desde Analytics
ANDY_BOT_TOKEN=
ANDY_BOT_MAIL=
